{
  "expo": {
    "name": "가계력",
    "slug": "gagyeryeok",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "gagyeryeok",
    "ios": {
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.ryubi.gagyeryeok",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "78d6d32e-1dd2-466e-9446-a3f222719eed"
      }
    },
    "owner": "janerim"
  }
}
